// Prisma schema for ArtPeriod
// Add your DATABASE_URL to .env.local to connect (see .env.example)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Users & Auth
// ------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  favorites     Favorite[]
  collections   Collection[]
  events        Event[]

  @@index([email])
}

// ------------------------------
// Artists
// ------------------------------

model Artist {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  bio           String?
  country       String?
  birthYear     Int?
  deathYear     Int?
  profileImage  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  artworks      Artwork[]

  @@index([name])
}

// ------------------------------
// Artworks
// ------------------------------

model Artwork {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  artistId          String
  artist            Artist    @relation(fields: [artistId], references: [id])
  year              Int?
  period            String?
  medium            String?
  imageUrl          String?
  thumbUrl          String?
  heroUrl           String?
  description       String?

  // Commerce / valuation
  isForSale         Boolean   @default(false)
  lastSalePrice     Float?
  lowestAsk         Float?
  estimatedValueLow Float?
  estimatedValueHigh Float?

  // Ranking / discovery
  popularityScore   Float     @default(0)
  viewCount         Int       @default(0)

  // AI hooks (reserved for future use)
  styleTags         String[]  @default([])
  subjectTags       String[]  @default([])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  priceHistory      PriceHistory[]
  favorites         Favorite[]
  views             ArtworkView[]
  collectionItems   CollectionArtwork[]
  auctions          Auction[]

  @@index([artistId])
  @@index([period])
  @@index([medium])
  @@index([isForSale])
  @@index([popularityScore])
}

// ------------------------------
// Price history & auctions
// ------------------------------

model PriceHistory {
  id          String   @id @default(cuid())
  artworkId   String
  artwork     Artwork  @relation(fields: [artworkId], references: [id])
  price       Float
  source      String?
  soldAt      DateTime @default(now())

  @@index([artworkId])
}

model Auction {
  id          String   @id @default(cuid())
  artworkId   String
  artwork     Artwork  @relation(fields: [artworkId], references: [id])
  house       String?
  status      String   @default("upcoming") // upcoming | live | closed
  startPrice  Float?
  currentBid  Float?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([artworkId])
  @@index([status])
}

// ------------------------------
// Collections & Favorites
// ------------------------------

model Collection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CollectionArtwork[]

  @@index([userId])
}

model CollectionArtwork {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])
  artworkId    String
  artwork      Artwork    @relation(fields: [artworkId], references: [id])
  addedAt      DateTime   @default(now())

  @@unique([collectionId, artworkId])
  @@index([collectionId])
  @@index([artworkId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  artworkId  String
  artwork    Artwork  @relation(fields: [artworkId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

// ------------------------------
// Analytics / instrumentation
// ------------------------------

model ArtworkView {
  id         String   @id @default(cuid())
  artworkId  String
  artwork    Artwork  @relation(fields: [artworkId], references: [id])
  userId     String?
  createdAt  DateTime @default(now())

  @@index([artworkId])
}

model Event {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  type       String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([type])
}
